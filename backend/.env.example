# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://tuition:tuition_dev_password@localhost:5432/tuition_dev

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-32+-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret

# --- WhatsApp OTP (Meta Cloud API) — optional ---
# Leave unset for local dev: OTPs are logged to the console instead of sent.
# Needs a Meta Business/WhatsApp Business Platform account with an
# approved "authentication" category template named WHATSAPP_OTP_TEMPLATE_NAME.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=otp_login
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_VERSION=v21.0

# --- Google Sign-In (web) — optional ---
# Leave unset to disable; POST /auth/google returns 503 until set.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# GOOGLE_CLIENT_ID=

# --- Object storage (Cloudflare R2) — optional ---
# Leave unset to fall back to local-disk storage for dev.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Local storage dev override ---
# Only used by the local-disk storage fallback above. The URL the API is
# reachable at from the *client* device, not the server's own localhost.
# Needed for physical devices / emulators, e.g. after `adb reverse tcp:3001
# tcp:3001` this can stay http://localhost:3001; on a real device on the
# same LAN, point it at the host's LAN IP instead.
# LOCAL_STORAGE_BASE_URL=http://localhost:3001

# --- Push notifications (Firebase Cloud Messaging, Android only for
# now) — optional ---
# Leave unset for local dev: push notifications are logged to the console
# instead of sent. Base64 of the full Firebase service-account JSON
# (Firebase console → Project settings → Service accounts).
# FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- PostHog (server-side event capture) — optional ---
# Leave unset to drop analytics events with a warning instead of sending.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error tracking) — optional ---
# Leave unset to disable; errors are still logged locally either way.
# SENTRY_DSN=

# --- Claude (AI weekly digest, quiz generator, doubt solver) — optional ---
# Leave unset for local dev / pre-commercialization testing: AI endpoints
# (POST /digests/.../generate) fall back to a templated mock provider —
# real stats, templated prose, clearly logged as mock output. Swap in a
# real key from console.anthropic.com when ready to commercialize; no
# code changes needed.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Small/fast model for the doubt solver's abuse/PII pre-screen (blueprint
# §8) — cheaper than the workhorse model above, used only for moderation.
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# --- Voyage AI (doubt-solver embeddings) — optional ---
# Leave unset for local dev / pre-commercialization testing: chunk/query
# embeddings fall back to a deterministic hashed bag-of-words vector —
# real cosine-similarity behaviour, not real semantic search. Claude has
# no embeddings endpoint; Voyage is Anthropic's own recommended
# embeddings partner. Get a key at dashboard.voyageai.com; no code
# changes needed either way.
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3

# --- Doubt solver monthly token budget (blueprint §5 unit-economics
# guardrail) — hard-stopped server-side per student, not advisory. ---
# AI_DOUBT_SOLVER_MONTHLY_TOKEN_CAP=200000

# --- Razorpay (fee collection, Route split, tutor payouts) — optional ---
# Leave unset for local dev / pre-commercialization testing: payment
# endpoints (POST /payments/fee/:id/order) fall back to a mock provider —
# fake order ids, always-succeeds capture via
# POST /payments/:id/simulate-capture (dev/test only; the real provider
# rejects that call, production capture is webhook-driven). Get test-mode
# keys at dashboard.razorpay.com once ready to test against the real
# sandbox, and live keys when ready to commercialize; no code changes
# needed either time.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Marketplace (blueprint §5/§10 Phase 4) ---
# 1:1 booking platform take rate. Blueprint gives a 15-20% range and
# leaves it unset; defaults to the upper bound (20), same resolution
# as parent premium's ₹149 pricing.
# MARKETPLACE_TAKE_RATE_PERCENT=20
# Density gate for Discover's curated-vs-open-search switch (blueprint
# §10: "≥25 active tutors + 250 active students in the metro").
# MARKETPLACE_DENSITY_GATE_TUTORS=25
# MARKETPLACE_DENSITY_GATE_STUDENTS=250
# How long a waitlist notification holds a slot exclusively before
# lapsing back to the general waitlist — invented, no blueprint anchor.
# MARKETPLACE_WAITLIST_WINDOW_HOURS=24

# --- Retool (read-only DB browsing) ---
# No env var here — the backend never reads a RETOOL_* value. Migration
# 0011 creates a `retool_readonly` Postgres role with SELECT-only access;
# its password is set manually per environment via
# `ALTER ROLE retool_readonly WITH PASSWORD '<secret>';` (never committed).
# Enter the resulting host/port/db/role/password directly into Retool's
# own Postgres resource connection UI. Admin writes must go through the
# existing REST API, never a Retool SQL mutation query, to preserve the
# audit_logs trail.
