# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://tuition:tuition_dev_password@localhost:5432/tuition_dev

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-32+-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret

# --- WhatsApp OTP (Meta Cloud API) — optional ---
# Leave unset for local dev: OTPs are logged to the console instead of sent.
# Needs a Meta Business/WhatsApp Business Platform account with an
# approved "authentication" category template named WHATSAPP_OTP_TEMPLATE_NAME.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=otp_login
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_VERSION=v21.0

# --- Google Sign-In (web) — optional ---
# Leave unset to disable; POST /auth/google returns 503 until set.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# GOOGLE_CLIENT_ID=
