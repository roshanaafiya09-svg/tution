# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://tuition:tuition_dev_password@localhost:5432/tuition_dev

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-32+-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret

# --- WhatsApp OTP (Meta Cloud API) — optional ---
# Leave unset for local dev: OTPs are logged to the console instead of sent.
# Needs a Meta Business/WhatsApp Business Platform account with an
# approved "authentication" category template named WHATSAPP_OTP_TEMPLATE_NAME.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=otp_login
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_VERSION=v21.0

# --- Google Sign-In (web) — optional ---
# Leave unset to disable; POST /auth/google returns 503 until set.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# GOOGLE_CLIENT_ID=

# --- Object storage (Cloudflare R2) — optional ---
# Leave unset to fall back to local-disk storage for dev.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Local storage dev override ---
# Only used by the local-disk storage fallback above. The URL the API is
# reachable at from the *client* device, not the server's own localhost.
# Needed for physical devices / emulators, e.g. after `adb reverse tcp:3001
# tcp:3001` this can stay http://localhost:3001; on a real device on the
# same LAN, point it at the host's LAN IP instead.
# LOCAL_STORAGE_BASE_URL=http://localhost:3001

# --- Push notifications (Firebase Cloud Messaging, Android only for
# now) — optional ---
# Leave unset for local dev: push notifications are logged to the console
# instead of sent. Base64 of the full Firebase service-account JSON
# (Firebase console → Project settings → Service accounts).
# FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- PostHog (server-side event capture) — optional ---
# Leave unset to drop analytics events with a warning instead of sending.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error tracking) — optional ---
# Leave unset to disable; errors are still logged locally either way.
# SENTRY_DSN=

# --- Retool (read-only DB browsing) ---
# No env var here — the backend never reads a RETOOL_* value. Migration
# 0011 creates a `retool_readonly` Postgres role with SELECT-only access;
# its password is set manually per environment via
# `ALTER ROLE retool_readonly WITH PASSWORD '<secret>';` (never committed).
# Enter the resulting host/port/db/role/password directly into Retool's
# own Postgres resource connection UI. Admin writes must go through the
# existing REST API, never a Retool SQL mutation query, to preserve the
# audit_logs trail.
