{
  "$schema": "Tuition App Design Tokens — single source of truth. Mirrored into web/tailwind.config.ts and (once scaffolded) mobile/lib/design_system/theme.dart. Do not fork values — edit here first.",
  "meta": {
    "name": "Scholar",
    "description": "Premium, education-first design language. Deep indigo (trust, focus, academia) paired with a warm marigold accent (energy, celebration, India-appropriate warmth). Editorial serif for display/marketing, humanist sans for UI/product.",
    "version": "1.0.0"
  },
  "color": {
    "brand": {
      "50": "#EEF0FC",
      "100": "#D8DCF8",
      "200": "#B4BBF1",
      "300": "#8A93E6",
      "400": "#5F68D6",
      "500": "#4249C2",
      "600": "#3532A8",
      "700": "#2B2887",
      "800": "#221F6B",
      "900": "#1A1852",
      "950": "#100F35"
    },
    "accent": {
      "50": "#FFF8EB",
      "100": "#FFECC2",
      "200": "#FFDA8A",
      "300": "#FFC24D",
      "400": "#FFAB1F",
      "500": "#F59A0C",
      "600": "#D97F06",
      "700": "#B4620A",
      "800": "#8F4C10",
      "900": "#743F10",
      "950": "#421F04"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FAF9F7",
      "100": "#F3F1ED",
      "200": "#E6E2DB",
      "300": "#D2CCC1",
      "400": "#AAA290",
      "500": "#847B69",
      "600": "#635B4C",
      "700": "#4A4438",
      "800": "#332F27",
      "900": "#211E18",
      "950": "#14120E"
    },
    "semantic": {
      "success": { "DEFAULT": "#1F8A5C", "bg": "#E7F6EE", "dark": "#4ADE9B" },
      "warning": { "DEFAULT": "#B4620A", "bg": "#FFF3DF", "dark": "#F0A845" },
      "error": { "DEFAULT": "#C4372E", "bg": "#FBEAE8", "dark": "#F2887E" },
      "info": { "DEFAULT": "#2B6CB0", "bg": "#E9F2FB", "dark": "#6FA8E8" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": ["Fraunces", "Noto Serif Tamil", "Georgia", "serif"],
      "sans": ["Inter", "Noto Sans Tamil", "system-ui", "sans-serif"]
    },
    "note": "Display (Fraunces) is used for marketing/public pages and section headers — gives an editorial, premium academic feel that avoids generic-SaaS blue-on-white. Sans (Inter) is used for all product UI, forms, and dense data (attendance, fee ledger). Noto Sans/Serif Tamil are fallback stacks for bilingual EN/TA rendering.",
    "scale": {
      "display-2xl": { "size": "4.5rem", "lineHeight": "1.05", "tracking": "-0.02em", "weight": "600", "family": "display" },
      "display-xl": { "size": "3.5rem", "lineHeight": "1.08", "tracking": "-0.02em", "weight": "600", "family": "display" },
      "display-lg": { "size": "2.75rem", "lineHeight": "1.12", "tracking": "-0.01em", "weight": "600", "family": "display" },
      "display-md": { "size": "2.25rem", "lineHeight": "1.18", "tracking": "-0.01em", "weight": "600", "family": "display" },
      "h1": { "size": "1.875rem", "lineHeight": "1.25", "weight": "700", "family": "sans" },
      "h2": { "size": "1.5rem", "lineHeight": "1.3", "weight": "700", "family": "sans" },
      "h3": { "size": "1.25rem", "lineHeight": "1.35", "weight": "600", "family": "sans" },
      "body-lg": { "size": "1.125rem", "lineHeight": "1.6", "weight": "400", "family": "sans" },
      "body": { "size": "1rem", "lineHeight": "1.6", "weight": "400", "family": "sans" },
      "body-sm": { "size": "0.875rem", "lineHeight": "1.5", "weight": "400", "family": "sans" },
      "caption": { "size": "0.75rem", "lineHeight": "1.4", "weight": "500", "family": "sans" }
    }
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "2xl": "2rem",
    "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px 0 rgb(20 18 14 / 0.04)",
    "sm": "0 1px 3px 0 rgb(20 18 14 / 0.06), 0 1px 2px -1px rgb(20 18 14 / 0.06)",
    "md": "0 4px 12px -2px rgb(20 18 14 / 0.08), 0 2px 6px -3px rgb(20 18 14 / 0.06)",
    "lg": "0 12px 28px -6px rgb(20 18 14 / 0.12), 0 4px 10px -6px rgb(20 18 14 / 0.08)",
    "focus-ring": "0 0 0 3px rgb(66 73 194 / 0.35)"
  },
  "spacing": {
    "note": "Uses Tailwind's default 4px base scale — no override needed. Semantic aliases below are for layout consistency across web/mobile.",
    "page-gutter": "1.5rem",
    "section-gap": "6rem",
    "card-padding": "1.5rem"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)", "emphasized": "cubic-bezier(0.2, 0, 0, 1)" }
  }
}
