# Base URL of the NestJS API (see backend/.env.example)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Same Google OAuth Client ID as backend/.env's GOOGLE_CLIENT_ID — must
# match exactly, since the frontend requests the ID token that the
# backend then verifies. Leave unset to hide the Google button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Sentry (error tracking) — optional ---
# Leave unset to disable browser/server error reporting.
# NEXT_PUBLIC_SENTRY_DSN=

# --- PostHog (analytics + feature flags) — optional ---
# Leave unset to disable client-side event capture.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry source-map upload (build-time only) ---
# Not read from this file — set SENTRY_AUTH_TOKEN, SENTRY_ORG, and
# SENTRY_PROJECT in Vercel's project dashboard (Settings → Environment
# Variables), since this app has no CI pipeline in this repo and deploys
# via Vercel directly.
